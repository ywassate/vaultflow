# Configuration du Gateway

# Base de données PostgreSQL
DATABASE_URL=postgresql+psycopg://<utilisateur>:<mot_de_passe>@localhost:5432/storage

# Secret pour signer les JWT (obligatoire) : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Service HSM (optionnel, pour plus tard)
HSM_URL=http://localhost:8000

# Port du gateway
GATEWAY_PORT=8080

# Accès MinIO du gateway (obligatoire)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=secure-files

# Durée de vie des jetons d'accès, en minutes (60 par défaut)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Connexion : nombre d'échecs tolérés par adresse IP et par compte, et fenêtre en secondes
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
